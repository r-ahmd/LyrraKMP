<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- Squircle background with a subtle top-to-bottom pink gradient -->
    <path
        android:pathData="M 512,144 C 200,144 144,200 144,512 S 200,880 512,880 S 880,824 880,512 S 824,144 512,144 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="512"
                android:startY="144"
                android:endX="512"
                android:endY="880"
                android:type="linear">
                <item android:offset="0" android:color="#FBCFE8" /> <!-- Pink 200 -->
                <item android:offset="1" android:color="#F472B6" /> <!-- Pink 400 -->
            </gradient>
        </aapt:attr>
    </path>

    <!-- Simulated Shadows for depth (Soft dark purple, offset slightly) -->
    <!-- Dot shadow (X+20, Y+20 offset) -->
    <path
        android:pathData="M 460,630 m -80,0 a 80,80 0,1 1,160 0 a 80,80 0,1 1,-160 0"
        android:fillColor="#310D61"
        android:fillAlpha="0.25" />
    <!-- Earbud shadow -->
    <path
        android:pathData="M 670,320 m -60,0 a 60,60 0,1 1,120 0 a 60,60 0,1 1,-120 0"
        android:fillColor="#310D61"
        android:fillAlpha="0.25" />
    <path
        android:pathData="M 640,320 L 640,620"
        android:strokeColor="#310D61"
        android:strokeWidth="60"
        android:strokeLineCap="round"
        android:strokeAlpha="0.25" />

    <!-- Main Emblem: Deep Purple -->
    <!-- Bottom left dot (Shifted up and towards the right earbud) -->
    <path
        android:pathData="M 440,610 m -80,0 a 80,80 0,1 1,160 0 a 80,80 0,1 1,-160 0"
        android:fillColor="#4C1D95" />

    <!-- Right earbud shape (Stem + Head) -->
    <!-- Circular head -->
    <path
        android:pathData="M 650,300 m -60,0 a 60,60 0,1 1,120 0 a 60,60 0,1 1,-120 0"
        android:fillColor="#4C1D95" />
    <!-- Vertical stem -->
    <path
        android:pathData="M 620,300 L 620,600"
        android:strokeColor="#4C1D95"
        android:strokeWidth="60"
        android:strokeLineCap="round" />

</vector>
